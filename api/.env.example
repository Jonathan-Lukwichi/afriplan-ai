# Copy this file to api/.env and fill in the values.
# .env is gitignored — never commit secrets.

# Anthropic key for the PDF vision-estimator pipeline and Live Pricing's
# RFQ-reply parsing. Without it, only the DXF pipeline is functional.
ANTHROPIC_API_KEY=

# Free alternative: Google Gemini (key from https://aistudio.google.com/apikey).
# Used when it is the only key set, or when AI_PROVIDER=gemini. Free-tier limits are
# small (a few requests a minute), so PDF runs are slower; on the free tier Google may
# use what you send to improve its products — mind client confidentiality.
GEMINI_API_KEY=
AI_PROVIDER=
# Optional model overrides (defaults: gemini-2.5-flash / gemini-2.5-flash-lite)
# GEMINI_MODEL=
# GEMINI_FAST_MODEL=

# SQLite file path (created automatically on first run if missing).
DATABASE_URL=sqlite:///./data/afriplan.db

# Report email delivery (optional — Download/Email BoQ feature).
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=onboarding@resend.dev

# Demo login credentials (placeholder auth — see CLAUDE.md / plan notes).
DEMO_EMAIL=demo@afriplan.local
DEMO_PASSWORD=afriplan-demo
